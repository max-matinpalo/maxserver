{
	"compilerOptions": {
		"checkJs": true,
		"module": "ES2020",
		"target": "ES2020",
		"moduleResolution": "bundler",
		"strict": false,
		"noUnusedParameters": false,
		"noUnusedLocals": false,
		"noImplicitAny": false,
		"skipLibCheck": true,
		"types": [
			"bun",
			"maxserver"
		]
	},
	"include": [
		"src"
	],
	"exclude": [
		"node_modules",
	],
}